  "strings": {
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno registra l'audio degli altri partecipanti alle riunioni per trascriverlo."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno dà alla nota della riunione il nome dell'evento in corso ed elenca chi è stato invitato."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steno registra la tua voce durante le riunioni per trascriverla."
          }
        }
      }
    }
  },
  "version": "1.0"
}