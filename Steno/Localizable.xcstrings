{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a valid file name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" non è un nome di file valido."
          }
        }
      }
    },
    "%@ The note will be created at the end of Processing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La nota verrà creata a fine Elaborazione."
          }
        }
      }
    },
    "%@ Track: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia %1$@: %2$@"
          }
        }
      }
    },
    "%@ keeps changing while Steno tries to update it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua a cambiare mentre Steno prova ad aggiornarla."
          }
        }
      }
    },
    "A new Template starts from Notes: change instructions and sections in Obsidian. They live in Meetings/_Templates/ in the Vault.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Template nuovo parte da Notes: in Obsidian cambi istruzioni e sezioni. Sono in Meetings/_Templates/ nel Vault."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API"
          }
        }
      }
    },
    "Add Profile": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi Profilo"
          }
        }
      }
    },
    "Any server with an OpenAI-compatible API. For work meetings use only local Providers or Providers based and hosting data in the EU.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi server con API compatibile OpenAI. Per le riunioni di lavoro usa solo Provider locali o con sede e dati in UE."
