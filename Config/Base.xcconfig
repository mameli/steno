// Shared settings of the Steno target.
PRODUCT_NAME = Steno
PRODUCT_BUNDLE_IDENTIFIER = dev.mameli.steno
MARKETING_VERSION = 0.1.1
CURRENT_PROJECT_VERSION = 1

MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0

INFOPLIST_FILE = Config/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// User-facing strings are in English in the code, translated in Steno/*.xcstrings.
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
COMBINE_HIDPI_IMAGES = YES

// Without Local.xcconfig the app is signed ad hoc: it builds, but macOS may
// ask for the permissions again after every build.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
